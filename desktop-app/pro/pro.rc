// pro.rc: the resources of the professional program communitybridge_pro: the same icon and manifest as the old program
// (CMake copies app.ico and app.manifest next to the build files) and its own version information 4.0.0.0.
#include <windows.h>
#include <commctrl.h>
#include "include/resource.h"

// The icon of the program (the first icon resource is the one that Explorer and the taskbar show).
IDI_APP ICON "app.ico"

// The manifest switches on Common Controls 6 and the per-monitor dpi awareness. 24 is the resource type RT_MANIFEST.
1 24 "app.manifest"

// The version information that Windows shows in the file properties.
VS_VERSION_INFO VERSIONINFO
FILEVERSION 4,0,0,0
PRODUCTVERSION 4,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "CommunityBridge student project"
            VALUE "FileDescription", "CommunityBridge Pro - surplus food to the recipients who can take it"
            VALUE "FileVersion", "4.0.0.0"
            VALUE "InternalName", "communitybridge_pro"
            VALUE "OriginalFilename", "communitybridge_pro.exe"
            VALUE "ProductName", "CommunityBridge"
            VALUE "ProductVersion", "4.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
